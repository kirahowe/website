{;; Development: serve the local content repo directly, no git syncing.
 ;; This is the same repo prod clones (kirahowe-content); authoring now
 ;; happens in the standalone app
 :content-path "~/code/projects/kirahowe-content"
 :content-git-url nil

 ;; `claude` wrapped with this machine's personal config dir
 :llm-command "clk"

 ;; Dev runs on its own port so it never fights the prod port (8080).
 :port 8100}
