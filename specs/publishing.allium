-- allium: 3
-- publishing.allium
--
-- Scope: Content freshness on the production server for kirahowe.com —
--   how the running site comes to be serving the newest published
--   content: boot, the content repo's push webhook, the fallback pull,
--   adopting a new revision, and surviving a refresh that fails.
-- Includes: the Server and the revision it serves; the refresh
--   announcement the content repo sends (its already-current short
--   circuit and its coalescing debounce); the timed fallback sync; the
--   best-effort CDN purge that follows a revision the server adopts;
--   what a failed refresh does, and does not, do to the live site.
-- Excludes:
--   - Authoring and publishing. Since 2026-08-06 an entry is written,
--     queued and published in the admin app (repo website-admin, spec
--     specs/authoring.allium THERE), which commits straight into the
--     public content repo through the GitHub API. Everything this repo
--     used to carry on the author's Mac — the vault -> content mirror,
--     `bb publish` / `bb publish-queued` / `bb sync`, the publish queue
--     and its flush, the pre-publish lint pass, the launchd autopublish
--     agent and its desktop failure notices — was deleted on that date.
--     None of that lifecycle is specified here any more; URL-collision
--     enforcement moved with it, into the admin app's publish path.
--   - Rendering, the URL scheme, archives, feeds, search — the content
--     & serving model (content.allium)
--   - Dev-only conveniences: live reload, per-request reindexing and
--     /drafts previews. Dev serves the content directory directly and
--     has nothing to refresh.
-- Dependencies: none. The Entry model (entries.allium) is deliberately
--   not imported: the server's unit of freshness is a content revision,
--   not an entry.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The environment the production server runs in: the platform that
-- boots it (Fly) and keeps it running.
external entity HostEnvironment {}

-- The public content repo. The admin app commits published entries into
-- it; its push webhook is what tells the server there is something new
-- to fetch.
external entity ContentRepo {}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- The production server. Created at boot; serves the published content
-- of the revision it last indexed successfully.
entity Server {
    served_rev: String?                  -- null until the first successful index: an empty site, not a crash
    next_sync_at: Timestamp              -- the fallback pull's next tick
    refresh_window_ends_at: Timestamp?   -- null before the first refresh; while still in the future, a
                                         -- refresh has already run inside this window
    trailing_refresh_at: Timestamp?      -- the single refresh queued for the window's end, if any
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    refresh_debounce: Duration = 10.seconds          -- :refresh-debounce-seconds
    content_sync_interval: Duration = 1800.seconds   -- :content-sync-seconds in config/prod.edn
    boot_retry_interval: Duration = 60.seconds       -- the fallback tick's cadence while served_rev is
                                                     -- still null; hardcoded 60 in start-sync-loop!,
                                                     -- not a config key
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Boot -------------------------------------------------------------

rule ServerBoots {
    when: ServerBoots(_)
    ensures: Server.created(
        served_rev: null,
        next_sync_at: now,
        refresh_window_ends_at: null,
        trailing_refresh_at: null
    )
    @guidance
        -- next_sync_at = now: the first tick fires immediately, cloning
        -- and indexing the content. Until an index succeeds the site
        -- serves empty rather than crash-looping, and the tick keeps
        -- retrying every boot_retry_interval — so an empty boot heals
        -- within about a minute of the content becoming reachable,
        -- without waiting on a push that may not come for days.
}

-- The content repo's push announcement ------------------------------

rule ServerSkipsCurrentRevision {
    when: ContentRepoAnnouncesPush(_, server, sha?)
    requires: sha != null
    requires: sha = server.served_rev
    ensures: RefreshReportedCurrent(server: server)
    @guidance
        -- The announced revision is the one already indexed, so there is
        -- nothing to fetch: the server answers "current" without
        -- touching the content checkout at all. An announcement that
        -- names no revision (a ping, a manual poke) cannot take this
        -- path.
}

rule ServerRefreshesOnPush {
    when: ContentRepoAnnouncesPush(_, server, sha?)
    let already_served = sha != null and sha = server.served_rev
    requires: not already_served
    requires: server.refresh_window_ends_at = null or server.refresh_window_ends_at <= now
    ensures:
        server.refresh_window_ends_at = now + config.refresh_debounce
        ContentRefreshAttempted(server: server)
    @guidance
        -- The first announcement of a window refreshes immediately, in
        -- the request, and the refresh's own outcome — updated,
        -- unchanged or error — is the answer the sender sees.
}

rule ServerQueuesRefreshWithinWindow {
    when: ContentRepoAnnouncesPush(_, server, sha?)
    let already_served = sha != null and sha = server.served_rev
    let refresh_queued = server.trailing_refresh_at != null
    requires: not already_served
    requires: server.refresh_window_ends_at != null and server.refresh_window_ends_at > now
    ensures:
        if not refresh_queued:
            server.trailing_refresh_at = server.refresh_window_ends_at
        RefreshReportedScheduled(server: server)
    @guidance
        -- One publish from the admin app lands as several commits
        -- seconds apart, each firing its own webhook, so the window
        -- coalesces rather than drops: the first announcement inside it
        -- queues the trailing refresh, every later one joins that same
        -- queued refresh, and all of them are answered "scheduled".
}

rule ServerRunsQueuedRefresh {
    when: server: Server.trailing_refresh_at <= now
    requires: server.trailing_refresh_at != null
    ensures:
        server.trailing_refresh_at = null
        server.refresh_window_ends_at = now + config.refresh_debounce
        ContentRefreshAttempted(server: server)
    @guidance
        -- The queued refresh runs when the window closes and opens a
        -- fresh window behind it. Because it was queued and not
        -- discarded, the last push of a burst is picked up within one
        -- debounce window of arriving, never left to the fallback tick.
}

-- The fallback pull -------------------------------------------------

rule ServerSyncTick {
    when: server: Server.next_sync_at <= now
    let never_indexed = server.served_rev = null
    ensures:
        if never_indexed:
            server.next_sync_at = now + config.boot_retry_interval
        else:
            server.next_sync_at = now + config.content_sync_interval
        ContentRefreshAttempted(server: server)
    @guidance
        -- The fallback, not the primary path: freshness normally arrives
        -- by webhook within seconds of a publish. This tick exists
        -- because GitHub does not retry a webhook delivery it failed to
        -- make — a missed delivery heals here — and because a refresh
        -- that failed is retried on every tick until the content is
        -- fixed. The cadence is impatient while the server has nothing
        -- to serve and settles once it does: a webhook only fires on a
        -- push, so it cannot heal a boot that failed on a quiet day —
        -- only this tick can. The refresh itself (a pull, or a clone if
        -- the checkout is missing, then a reindex if the revision moved)
        -- happens outside the system; its outcome arrives as
        -- ContentRefreshSucceeded or ContentRefreshFailed.
}

-- Refresh outcomes --------------------------------------------------

rule ServerAdoptsNewContent {
    when: ContentRefreshSucceeded(server, rev)
    requires: server.served_rev = null or server.served_rev != rev
    ensures:
        server.served_rev = rev
        HomepagePurgeRequested(server: server)
    @guidance
        -- Adopting a revision is also what asks the CDN to drop its copy
        -- of the home page. That one URL is the whole request: the home
        -- page is the only surface pinned at the edge for a long TTL, so
        -- every other page carries a short max-age and heals itself
        -- without being asked. A refresh that changed nothing asks for
        -- nothing. A fresh boot adopts its first revision through this
        -- same rule — clone, index, purge — which is what makes a code
        -- deploy visible on the pinned home page.
}

rule ServerToleratesFailedRefresh {
    when: ContentRefreshFailed(server, reason)
    ensures: RefreshFailureLogged(server: server, reason: reason)
    @guidance
        -- The served index is untouched — the last good content keeps
        -- serving — and the next refresh, webhook or fallback tick,
        -- retries; a bad push heals itself once the content is fixed.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The content repo's push webhook: the primary freshness trigger.
surface ContentRefreshEndpoint {
    facing repo: ContentRepo

    context server: Server

    provides:
        ContentRepoAnnouncesPush(repo, server, sha?)

    timeout:
        ServerRunsQueuedRefresh

    @guarantee OpenButHarmless
        -- The endpoint takes no credential and needs none: all it can be
        -- made to do is fetch a public repo the site already serves, at
        -- a rate the debounce bounds. The server does hold secrets — the
        -- CDN purge credentials — but this endpoint neither reads nor
        -- discloses them; the most it can spend them on is a purge of
        -- the site's own home page, and only when the public revision
        -- actually moved.
    @guarantee CurrentRevisionCostsNothing
        -- An announcement naming the revision already served does no
        -- work at all: no fetch, no reindex.
    @guarantee AtMostOneRefreshPerWindow
        -- However many announcements arrive, no more than one refresh
        -- runs per refresh_debounce window.
    @guarantee BurstsCoalesceNeverDrop
        -- An announcement arriving inside a window is never discarded: a
        -- refresh runs at or after that window's end, so the last push
        -- of a burst is always picked up without waiting for the
        -- fallback tick.
    @guidance
        -- Realized as POST /refresh, which exists only where content
        -- comes from git. The revision is the push payload's "after"; an
        -- announcement carrying none simply cannot take the short
        -- circuit. The answer names the outcome — current, scheduled,
        -- updated, unchanged or error — and only error is a failure the
        -- sender should see as one.
}

-- The server's side of the pipeline: what boots it, and where its
-- content refresh outcomes come from.
surface ServerRuntime {
    facing host: HostEnvironment

    provides:
        ServerBoots(host)
        ContentRefreshSucceeded(server, rev)
        ContentRefreshFailed(server, reason)

    timeout:
        ServerSyncTick

    @guarantee PurgeNeverFailsARefresh
        -- The home page purge that follows an adopted revision is best
        -- effort: a purge that fails is logged and swallowed, and the
        -- refresh that prompted it still reports success. Serving a
        -- stale copy at the edge for a while is preferable to reporting
        -- a good content refresh as broken because the CDN was
        -- unreachable.
    @guidance
        -- The boot comes from the platform starting the machine; the
        -- refresh outcomes come from git against the public content
        -- repo. ContentRefreshAttempted going out and these coming back
        -- is the whole conversation about content, whichever trigger —
        -- webhook or fallback tick — asked for the refresh.
        -- HomepagePurgeRequested goes out the same way but is never
        -- answered: no rule waits on its outcome, which is what makes it
        -- best effort rather than a step in the pipeline.
}

-- The visitor-facing PublishedSite surface lives in content.allium,
-- which owns the serving model; its AlwaysUp / EventualFreshness
-- guarantees are backed by the Server rules above.
